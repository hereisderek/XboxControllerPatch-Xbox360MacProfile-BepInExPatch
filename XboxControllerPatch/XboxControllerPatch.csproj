<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net46</TargetFramework>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!--
    Off by default: a plain `dotnet build` (as documented in this project's own
    README) produces a fully working, standalone patch, no ticket check, no
    source edits needed. Only the official distribution build (see the parent
    "Overcooked2 Xbox Patched" repo's build.sh, run with
    the build_patch option) passes RequireLicenseTicket=true to compile the
    check in, gating its own precompiled DLL behind a launcher issued ticket.
    See LicenseTicket.cs.

    The two variants get distinct AssemblyNames (and so distinct output
    filenames) for the same reason: mixing up which one is actually staged
    into BepInEx/patchers/ has bitten us before (a stray copy of the wrong
    variant left in there loads *alongside* the intended one - BepInEx loads
    every DLL it finds there - silently defeating the ticket check). A
    self-describing filename makes that mistake obvious at a glance instead of
    requiring a rebuild to notice.
  -->
  <PropertyGroup Condition="'$(RequireLicenseTicket)'=='true'">
    <DefineConstants>$(DefineConstants);REQUIRE_LICENSE_TICKET</DefineConstants>
    <AssemblyName>MacOSXboxControllerPatchAuth</AssemblyName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RequireLicenseTicket)'!='true'">
    <AssemblyName>MacOSXboxControllerPatchNoAuth</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net46" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Preloader">
      <HintPath>lib/BepInEx.Preloader.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>lib/BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="Mono.Cecil">
      <HintPath>lib/Mono.Cecil.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
